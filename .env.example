# Copy the lines you need into .env (which Git ignores) and fill in real values.
# Never put real keys in this file.
LLM_API_GATEWAY=https://your-course-gateway.example/v1
LLM_API_TOKEN=replace-with-your-course-token

# Folder that holds the archive's registry/ and raw/ folders (the Shared Drive).
# Forward slashes work on Windows.
ARCHIVE_ROOT="I:/Shared drives/JBPHH DW Archive & Registry"
